# ============================================================================
# Env var template — copy to .env.local and fill in real values there.
# .env.local is gitignored; this file (.env.example) is the only .env* that
# gets committed, and must never contain a real secret.
#
# NEXT_PUBLIC_* vars are inlined at BUILD time — changing one needs a full
# rebuild, not just a restart. Everything else is read at process start and
# only needs a restart.
# ============================================================================

# --- Supabase (EU region project) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
# Default/dev site URL. Per-site values live in the `sites` table — this is
# only a fallback for local dev before the DB has real rows.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CDN_HOST=
# Force a site in dev without editing hosts: 'FR' | 'DE' | ...
DEV_SITE_COUNTRY=FR

# --- AI ------------------------------------------------------------------
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=

# --- Affiliate networks — France --------------------------------------------
AWIN_FR_PUBLISHER_ID=
AWIN_FR_API_KEY=
KWANKO_API_KEY=
KWANKO_ADVERTISER_ID=
EFFILIATION_API_KEY=
TRADEDOUBLER_FR_SITE_ID=
TRADEDOUBLER_FR_PRODUCTS_TOKEN=
TRADEDOUBLER_FR_VOUCHERS_TOKEN=

# --- Affiliate networks — Germany (Phase 9, fill in when DE launches) ------
AWIN_DE_PUBLISHER_ID=
AWIN_DE_API_KEY=
BELBOON_API_KEY=
ADCELL_API_KEY=
TRADEDOUBLER_DE_SITE_ID=
TRADEDOUBLER_DE_PRODUCTS_TOKEN=
TRADEDOUBLER_DE_VOUCHERS_TOKEN=

# --- Push (per-site VAPID keypairs live in site_secrets, not here — these
# are only a fallback for local dev / the "Add country" form default) ------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# --- Automation ---------------------------------------------------------
CRON_SECRET=
WORKFLOW_PAT=
